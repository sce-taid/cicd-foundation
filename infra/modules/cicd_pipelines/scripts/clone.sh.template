git clone "${_GIT_CLONE_URL}" /workspace
if [ "${_IS_GIT_REPO_WEBHOOK}" = "true" ]; then
  cd /workspace
  git checkout "${_GIT_REPO_REF}"
elif [ -n "${COMMIT_SHA}" ]; then
  cd /workspace
  git reset --hard "${COMMIT_SHA}"
fi
